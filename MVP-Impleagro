-- ============================================================
-- Catálogo Interativo de Peças Agrícolas
-- Tabelas de apoio à Central de Desenvolvimento (área interna)
-- Este script é ADITIVO: não altera nem apaga as tabelas do MVP
-- (fabricantes, modelos, catalogos, pecas, marcacoes).
-- Execute no SQL Editor do Supabase.
-- ============================================================

drop table if exists modulos cascade;
drop table if exists versoes cascade;
drop table if exists documentos_central cascade;

-- Cada linha representa um módulo do roadmap do produto.
-- status: 'concluido' | 'em_desenvolvimento' | 'pendente'
create table modulos (
  id uuid primary key default gen_random_uuid(),
  nome text not null,
  fase text,                 -- ex: "Estrutura", "PDF", "IA"
  status text not null default 'pendente'
    check (status in ('concluido', 'em_desenvolvimento', 'pendente')),
  ordem integer not null,
  descricao text,
  criado_em timestamp default now()
);

-- Histórico de versões do sistema.
create table versoes (
  id uuid primary key default gen_random_uuid(),
  numero text not null,      -- ex: "v0.1"
  data_lancamento date not null,
  resumo text,
  criado_em timestamp default now()
);

-- Lista de documentos do /docs, usada para montar os links na Central.
create table documentos_central (
  id uuid primary key default gen_random_uuid(),
  nome text not null,        -- ex: "Manifesto do Projeto"
  caminho text not null,     -- ex: "docs/MANIFEST.md" (caminho dentro do repositório)
  categoria text,            -- ex: "Base", "EFS", "Prompts"
  ordem integer not null
);

-- Acesso liberado apenas para esta fase de testes (mesma lógica das outras tabelas).
alter table modulos enable row level security;
alter table versoes enable row level security;
alter table documentos_central enable row level security;

create policy "acesso temporario teste" on modulos for all using (true) with check (true);
create policy "acesso temporario teste" on versoes for all using (true) with check (true);
create policy "acesso temporario teste" on documentos_central for all using (true) with check (true);

